# Copia este archivo a .env si quieres cambiar la configuración local.
# TagFlow no usa servicios externos: estos valores solo afectan a este equipo.

# Carpeta de la base SQLite, miniaturas y registro.
# Vacío = %USERPROFILE%\.tagflow
TAGFLOW_DATA_DIR=

# Nivel de registro: DEBUG, INFO, WARNING, ERROR
TAGFLOW_LOG_LEVEL=INFO

# Lado máximo de las miniaturas, en píxeles.
TAGFLOW_THUMB_SIZE=320
