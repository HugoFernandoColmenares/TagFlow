/* TagFlow — interfaz oscura, pensada para revisar fotos durante un rato. */

QMainWindow, QDialog, QWidget {
    background: #12141a;
    color: #f3efe6;
}

QLabel {
    background: transparent;
    color: #f3efe6;
}

QLabel#Title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

QLabel#Subtitle, QLabel#Muted {
    color: #c4bdb0;
}

QLabel#Section {
    color: #e8a54b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QLabel#EmptyTitle {
    font-size: 22px;
    font-weight: 650;
}

QLabel#StatValue {
    font-size: 13px;
    color: #f3efe6;
}

QFrame#Header {
    background: #171a21;
    border-bottom: 1px solid #2c313c;
}

QFrame#Card, QFrame#ImageCard {
    background: #1c2028;
    border: 1px solid #313744;
    border-radius: 14px;
}

QFrame#ImageCard:hover {
    border-color: #5c6575;
}

QFrame#ImageCard[selected="true"] {
    border: 1px solid #e8a54b;
    background: #242017;
}

QLabel#Tier {
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#Tier[tier="4K"] {
    background: #31456d;
    color: #d7e6ff;
}

QLabel#Tier[tier="HD"] {
    background: #245246;
    color: #d5f5ea;
}

QLabel#Tier[tier="Low-res"] {
    background: #5a4630;
    color: #ffe7c7;
}

QPushButton {
    background: #2a303b;
    color: #f3efe6;
    border: 1px solid #3c4452;
    border-radius: 10px;
    padding: 7px 12px;
    min-height: 18px;
}

QPushButton:hover {
    background: #343b49;
}

QPushButton:pressed {
    background: #232833;
}

QPushButton:disabled {
    color: #7d776d;
    background: #22262e;
    border-color: #2c313c;
}

QPushButton[variant="primary"] {
    background: #e8a54b;
    color: #1c1408;
    border: none;
    font-weight: 700;
}

QPushButton[variant="primary"]:hover {
    background: #f0b45d;
}

QPushButton[variant="primary"]:disabled {
    background: #6d5836;
    color: #d9d0c4;
}

QPushButton[variant="danger"] {
    background: #6d3532;
    color: #ffe4e0;
    border: none;
}

QPushButton[variant="danger"]:hover {
    background: #81413d;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: none;
    color: #e8a54b;
    padding: 4px 8px;
}

QLineEdit, QComboBox, QSpinBox, QListWidget, QTextEdit, QPlainTextEdit {
    background: #12151b;
    color: #f3efe6;
    border: 1px solid #3c4452;
    border-radius: 10px;
    padding: 6px 8px;
    selection-background-color: #e8a54b;
    selection-color: #1c1408;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #1c2028;
    color: #f3efe6;
    selection-background-color: #e8a54b;
    selection-color: #1c1408;
    border: 1px solid #3c4452;
    outline: none;
}

QCheckBox {
    spacing: 8px;
    color: #f3efe6;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #6a6256;
    background: #12151b;
}

QCheckBox::indicator:checked {
    background: #e8a54b;
    border-color: #e8a54b;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #3c4452;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #3c4452;
    border-radius: 5px;
}

QProgressBar {
    background: #2a303b;
    border: none;
    border-radius: 5px;
    max-height: 8px;
}

QProgressBar::chunk {
    background: #e8a54b;
    border-radius: 5px;
}

QMenuBar {
    background: #171a21;
    color: #f3efe6;
    border-bottom: 1px solid #2c313c;
}

QMenuBar::item:selected {
    background: #2a303b;
}

QMenu {
    background: #1c2028;
    color: #f3efe6;
    border: 1px solid #3c4452;
}

QMenu::item:selected {
    background: #e8a54b;
    color: #1c1408;
}

QToolTip {
    background: #1c2028;
    color: #f3efe6;
    border: 1px solid #3c4452;
    padding: 4px;
}

QMessageBox {
    background: #171a21;
}

QLabel#Chip {
    background: #34301f;
    color: #f6e7c4;
    border-radius: 9px;
    padding: 3px 8px;
}
